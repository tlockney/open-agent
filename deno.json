{
  "tasks": {
    "test": "deno test --allow-read --allow-env",
    "test:integration": "OA_INTEGRATION=1 deno test --allow-all integration/",
    "check": "deno check src/ integration/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "exclude": ["**/*.md", "**/*.html", ".claude/"]
  },
  "lint": {
    "exclude": [".claude/"],
    "rules": {
      "exclude": ["no-import-prefix", "require-await"]
    }
  },
  "test": {
    "exclude": [".claude/"]
  },
  "compilerOptions": {
    "strict": true
  }
}
